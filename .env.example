# Sunucu HTTP portu (önünde Cloudflare / SSL reverse proxy varsa 80 yeterli)
HTTP_PORT=80

# Canlı domain
SITE_URL=https://diyetisyen.mehmeterenozden.com
PUBLIC_URL=https://diyetisyen.mehmeterenozden.com
NEXT_PUBLIC_STRAPI_URL=https://diyetisyen.mehmeterenozden.com
CORS_ORIGIN=https://diyetisyen.mehmeterenozden.com

# Postgres
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=degistir-guclu-bir-sifre

# Strapi secrets — her biri benzersiz olmalı
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=degistir
ADMIN_JWT_SECRET=degistir
TRANSFER_TOKEN_SALT=degistir
JWT_SECRET=degistir
ENCRYPTION_KEY=degistir
